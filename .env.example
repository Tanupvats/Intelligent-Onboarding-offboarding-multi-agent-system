

# --- App ---------------------------------------------------------------
APP_ENV=dev                 # dev | staging | prod
APP_NAME=Intelligent Onboarding/Offboarding MAS
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false              # true for structured JSON logs, false for human-readable


JWT_SECRET=CHANGE_ME_to_a_long_random_string_at_least_32_chars_xxxx
JWT_EXPIRES_HOURS=8

# --- CORS --------------------------------------------------------------
# Comma-separated list of exact origins. No wildcards in prod.
CORS_ALLOW_ORIGINS=http://localhost:8501,http://localhost:8502,http://localhost:8503

# --- Data paths (relative to the process working directory) ------------
DATA_DIR=data
UPLOADS_DIR=uploads
USERS_CSV=data/users.csv
EMPLOYEES_CSV=data/employees.csv
TICKETS_CSV=data/ticket.csv

# --- Uploads -----------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTS=pdf,jpg,jpeg,png

# --- MCP subprocesses --------------------------------------------------
MCP_FS_COMMAND=python
MCP_FS_ARGS=servers/fs_server.py
MCP_EMAIL_COMMAND=python
MCP_EMAIL_ARGS=servers/email_server.py
MCP_TICKET_MIRROR=data/tickets_mirror.jsonl

# Filesystem MCP: paths the subprocess may read/write. Comma-separated.
FS_ALLOWED_DIRS=./uploads,./data
# Cap writes (bytes) to prevent disk-fill DoS
FS_MAX_BYTES=26214400

# --- Email (optional) --------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hr-bot-email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=your-hr-bot-email@gmail.com
SMTP_STARTTLS=true
SMTP_TIMEOUT=15

# --- LLM / agents ------------------------------------------------------
OLLAMA_MODEL=llama3.2

# --- LangSmith tracing (optional) --------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hr-multi-agent-system

# --- Frontend (read by Streamlit apps) ---------------------------------
# When backend runs in Docker and frontends run on host, this should be
# http://localhost:8000; when both run in docker-compose, use http://backend:8000.
HR_API_URL=http://localhost:8000
HR_API_TIMEOUT=60
